[954.425928, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[51d"]
[954.426354, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G"]
[954.426799, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[49d"]
[954.427442, "o", "\u001b[2d"]
[954.427884, "o", "\u001b[39;49m\u001b(B\u001b[m{% for interface in interface_list %}\r\u001b[3d"]
[954.428291, "o", "interface {{ interface.name }}\u001b[4;3H"]
[954.428649, "o", "description {{ interface.desc|upper|reverse }}\r\u001b[5d"]
[954.429007, "o", "{% if interface.uplink %}\u001b[6;3H"]
[954.429397, "o", "switchport mode trunk\r\u001b[7d"]
[954.429858, "o", "{% else %}\u001b[8;3H"]
[954.430447, "o", "switchport access vlan {{ interface.vlan }}\u001b[9;3H"]
[954.430843, "o", "switchport mode access\r\u001b[10d"]
[954.431236, "o", "{% endif %}\u001b[11;3H"]
[954.43164, "o", "speed {{ interface.name|get_interface_speed }}\r\u001b[12d"]
[954.432032, "o", "{% endfor %}\r\u001b[2d"]
