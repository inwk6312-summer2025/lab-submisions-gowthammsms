[685.435771, "o", "{% for interface in interface_list %}\r\u001b[3d"]
[685.436456, "o", "interface {{ interface.name }}\u001b[4;3H"]
[685.436856, "o", "description {{ interface.desc|upper|reverse }}\r\u001b[5d"]
[685.437261, "o", "{% if interface.uplink %}\u001b[6;3H"]
[685.437686, "o", "switchport mode trunk\r\u001b[7d"]
[685.438084, "o", "{% else %}\u001b[8;3H"]
[685.438449, "o", "switchport access vlan {{ interface.vlan }}\u001b[9;3H"]
[685.438845, "o", "switchport mode access\r\u001b[10d"]
[685.439228, "o", "{% endif %}\u001b[11;3H"]
[685.439664, "o", "speed {{ interface.name|get_interface_speed }}\r\u001b[12d"]
[685.440035, "o", "{% endfor %}\r\u001b[13d"]
