[362.246911, "o", "template = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task2.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[8d"]
[362.247344, "o", "\u001b(B\u001b[0;1m\u001b[31m# Define NetworkInterface class\r\u001b[9d"]
[362.247789, "o", "\u001b[36mclass\u001b[39m\u001b(B\u001b[m NetworkInterface:\u001b[10;5H"]
[362.248207, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m __init__\u001b[39m\u001b(B\u001b[m(self, name, description, vlan, uplink=\u001b(B\u001b[0;1m\u001b[35mFalse\u001b[39m\u001b(B\u001b[m):\u001b[11;9H"]
[362.248661, "o", "self.name = name\u001b[12;9H"]
[362.249067, "o", "self.description = description\u001b[13;9H"]
[362.249511, "o", "self.vlan = vlan\u001b[14;9H"]
[362.249961, "o", "self.uplink = uplink\r\u001b[16d"]
[362.250406, "o", "\u001b(B\u001b[0;1m\u001b[31m# Try with uplink = False\r\u001b[17d"]
[362.25083, "o", "\u001b[39m\u001b(B\u001b[minterface_obj = NetworkInterface(\u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet0/1\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"Server Port\"\u001b[39m\u001b(B\u001b[m, 10, uplink=\u001b(B\u001b[0;1m\u001b[35mFalse\u001b[39m\u001b(B\u001b[m)\r\u001b[19d"]
[362.251294, "o", "\u001b(B\u001b[0;1m\u001b[31m# Try with uplink = True by changing the above line\r\u001b[20d"]
[362.251707, "o", "# interface_obj = NetworkInterface(\"GigabitEthernet0/1\", \"Uplink Port\", 10, uplink=True)\r\u001b[22d"]
[362.252137, "o", "\u001b[39m\u001b(B\u001b[mprint(template.render(interface=interface_obj))\r\u001b[23d"]
