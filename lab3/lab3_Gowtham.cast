[496.645871, "o", "\r\u001b[2d"]
[496.646313, "o", "{% for n in range(10) %}\r\u001b[3d"]
[496.646684, "o", "interface GigabitEthernet0/{{ n+1 }}\u001b[4;3H"]
[496.647093, "o", "description {{ interface.description }}\r\u001b[5d"]
[496.647458, "o", "{% if n+1 == 1 %}\u001b[6;3H"]
[496.647737, "o", "switchport mode trunk\r\u001b[7d"]
[496.648201, "o", "{% else %}\u001b[8;3H"]
[496.648449, "o", "switchport access vlan {{ interface.vlan }}\u001b[9;3H"]
