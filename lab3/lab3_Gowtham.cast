[960.288944, "o", "\u001b(B\u001b[m"]
[960.28953, "o", "\r\u001b[50d"]
[960.290084, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[51d"]
[960.29053, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G"]
[960.291008, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[49d"]
[960.292584, "o", "\u001b[2d"]
[960.293057, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[3d"]
[960.293495, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[5d"]
[960.293989, "o", "\u001b(B\u001b[0;1m\u001b[31m# Setup Jinja2 environment\r\u001b[6d"]
[960.294425, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[8d"]
[960.294889, "o", "\u001b(B\u001b[0;1m\u001b[31m# Custom Jinja filter\r\u001b[9d"]
[960.295321, "o", "\u001b[36mdef\u001b[34m get_interface_speed\u001b[39m\u001b(B\u001b[m(interface_name):\u001b[10;5H"]
[960.295787, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'gigabit'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\u001b[11;9H"]
[960.296222, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 1000\u001b[12;5H"]
[960.296706, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'fast'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\u001b[13;9H"]
[960.297156, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 100\u001b[14;5H"]
[960.297638, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m\"unknown\"\r\u001b[16d"]
[960.298054, "o", "\u001b[31m# Register the filter\r\u001b[17d"]
[960.298486, "o", "\u001b[39m\u001b(B\u001b[mENV.filters[\u001b(B\u001b[0;1m\u001b[32m'get_interface_speed'\u001b[39m\u001b(B\u001b[m] = get_interface_speed\r\u001b[19d"]
[960.298946, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load the template\r\u001b[20d"]
[960.2994, "o", "\u001b[39m\u001b(B\u001b[mtemplate = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task8.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[22d"]
[960.299819, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load the YAML file\r\u001b[23d"]
[960.300275, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"data-task7.yml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[24;5H"]
[960.300704, "o", "interfaces = yaml.load(f, Loader=yaml.SafeLoader)\r\u001b[26d"]
[960.301167, "o", "\u001b(B\u001b[0;1m\u001b[31m# Render and print\r\u001b[27d"]
[960.301612, "o", "\u001b[39m\u001b(B\u001b[mprint(template.render(interface_list=interfaces))\u001b[28;8H"]
