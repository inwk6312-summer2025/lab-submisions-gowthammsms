[694.528434, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[3d"]
[694.528886, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[5d"]
[694.529275, "o", "\u001b(B\u001b[0;1m\u001b[31m# Setup Jinja2 environment\r\u001b[6d"]
[694.529715, "o", "\u001b[39m\u001b(B\u001b[mENV = Environment(loader=FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m))\r\u001b[8d"]
[694.530071, "o", "\u001b(B\u001b[0;1m\u001b[31m# Custom Jinja filter\r\u001b[9d"]
[694.530446, "o", "\u001b[36mdef\u001b[34m get_interface_speed\u001b[39m\u001b(B\u001b[m(interface_name):\u001b[10;5H"]
[694.530846, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'gigabit'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\u001b[11;9H"]
[694.531297, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 1000\u001b[12;5H"]
[694.531689, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m'fast'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m interface_name.lower():\u001b[13;9H"]
[694.532122, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m 100\u001b[14;5H"]
[694.532514, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m\"unknown\"\r\u001b[16d"]
[694.532927, "o", "\u001b[31m# Register the filter\r\u001b[17d"]
[694.533312, "o", "\u001b[39m\u001b(B\u001b[mENV.filters[\u001b(B\u001b[0;1m\u001b[32m'get_interface_speed'\u001b[39m\u001b(B\u001b[m] = get_interface_speed\r\u001b[19d"]
[694.533771, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load the template\r\u001b[20d"]
[694.53419, "o", "\u001b[39m\u001b(B\u001b[mtemplate = ENV.get_template(\u001b(B\u001b[0;1m\u001b[32m\"template-task8.j2\"\u001b[39m\u001b(B\u001b[m)\r\u001b[22d"]
[694.534582, "o", "\u001b(B\u001b[0;1m\u001b[31m# Load the YAML file\r\u001b[23d"]
[694.535005, "o", "\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"data-task7.yml\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[24;5H"]
[694.535395, "o", "interfaces = yaml.load(f, Loader=yaml.SafeLoader)\r\u001b[26d"]
[694.53581, "o", "\u001b(B\u001b[0;1m\u001b[31m# Render and print\r\u001b[27d"]
[694.536196, "o", "\u001b[39m\u001b(B\u001b[mprint(template.render(interface_list=interfaces))\r\u001b[28d"]
