[5688.759962, "o", "\u001b(B\u001b[m"]
[5688.760437, "o", "\r\u001b[50d"]
[5688.760812, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[51d"]
[5688.761168, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G"]
[5688.761524, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[49d"]
[5688.763334, "o", "\u001b[2d"]
[5688.763748, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[3d"]
[5688.764148, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[5688.764599, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[5d"]
[5688.765028, "o", "hosts = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'hosts.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[6d"]
[5688.765421, "o", "interfaces = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'interfaces.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[8d"]
[5688.76588, "o", "env = Environment(loader = FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m), trim_blocks=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\r\u001b[9d"]
[5688.766313, "o", "autoescape=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[5688.766782, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[11d"]
[5688.767215, "o", "loopback_config = template.render(data=interfaces)\r\u001b[13d"]
[5688.767627, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m host \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m hosts[\u001b(B\u001b[0;1m\u001b[32m\"hosts\"\u001b[39m\u001b(B\u001b[m]:\u001b[14;5H"]
[5688.768027, "o", "net_connect = Netmiko(host = host[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m],\u001b[15;27H"]
[5688.768443, "o", "username = host[\u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m],\u001b[16;27H"]
[5688.768852, "o", "password = host[\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m],\u001b[17;27H"]
[5688.769263, "o", "port = host[\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m],\u001b[18;27H"]
[5688.769667, "o", "device_type = host[\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m])\u001b[19;5H"]
[5688.770082, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Logged into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\u001b[20;5H"]
[5688.770474, "o", "output = net_connect.send_config_set(loopback_config.split(\u001b(B\u001b[0;1m\u001b[32m\"\\n\"\u001b[39m\u001b(B\u001b[m))\u001b[21;5H"]
[5688.770911, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Pushed config into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\u001b[22;5H"]
[5688.771292, "o", "net_connect.disconnect()\r\u001b[24d"]
[5688.771717, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Done!\"\u001b[39m\u001b(B\u001b[m)\r\u001b[2d"]
