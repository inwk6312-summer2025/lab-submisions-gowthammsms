[4974.547164, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m yaml\r\u001b[3d"]
[4974.547555, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[4974.547939, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko"]
[4974.548309, "o", "\u001b[?12l\u001b[?25h"]
