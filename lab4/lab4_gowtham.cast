[5961.206327, "o", "\u001b(B\u001b[m"]
[5961.206866, "o", "\r\u001b[50d"]
[5961.207307, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[51d"]
[5961.207773, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G"]
[5961.208198, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[49d"]
[5961.209859, "o", "\u001b[2d"]
[5961.210286, "o", "\u001b[39;49m\u001b(B\u001b[miimport yaml\r\u001b[3d"]
[5961.210752, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m jinja2 \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Environment, FileSystemLoader\r\u001b[4d"]
[5961.211211, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m netmiko \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m Netmiko\r\u001b[5d"]
[5961.211656, "o", "hosts = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'hosts.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[6d"]
[5961.21208, "o", "interfaces = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'interfaces.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[8d"]
[5961.212491, "o", "env = Environment(loader = FileSystemLoader(\u001b(B\u001b[0;1m\u001b[32m'.'\u001b[39m\u001b(B\u001b[m), trim_blocks=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m,\r\u001b[9d"]
[5961.212937, "o", "autoescape=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[5961.213352, "o", "template = env.get_template(\u001b(B\u001b[0;1m\u001b[32m'interfaces_config_template.j2'\u001b[39m\u001b(B\u001b[m)\r\u001b[11d"]
[5961.213773, "o", "loopback_config = template.render(data=interfaces)\r\u001b[13d"]
[5961.214234, "o", "\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m host \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m hosts[\u001b(B\u001b[0;1m\u001b[32m\"hosts\"\u001b[39m\u001b(B\u001b[m]:\r\u001b[14d "]
[5961.214678, "o", "net_connect = Netmiko(host = host[\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m],\u001b[15;3H"]
[5961.215102, "o", "username = host[\u001b(B\u001b[0;1m\u001b[32m\"username\"\u001b[39m\u001b(B\u001b[m],\u001b[16;3H"]
[5961.21555, "o", "password = host[\u001b(B\u001b[0;1m\u001b[32m\"password\"\u001b[39m\u001b(B\u001b[m],\u001b[17;3H"]
[5961.215984, "o", "port = host[\u001b(B\u001b[0;1m\u001b[32m\"port\"\u001b[39m\u001b(B\u001b[m],\u001b[18;3H"]
[5961.216404, "o", "device_type = host[\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m])\r\u001b[19d "]
[5961.216805, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Logged into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\r\u001b[20d "]
[5961.21725, "o", "output = net_connect.send_config_set(loopback_config.split(\u001b(B\u001b[0;1m\u001b[32m\"\\n\"\u001b[39m\u001b(B\u001b[m))\r\u001b[21d "]
[5961.217743, "o", "print(f\u001b(B\u001b[0;1m\u001b[32m\"Pushed config into {host['name']} successfully\"\u001b[39m\u001b(B\u001b[m)\r\u001b[22d "]
[5961.218207, "o", "net_connect.disconnect()\r\u001b[24d"]
[5961.218615, "o", "print(\u001b(B\u001b[0;1m\u001b[32m\"Done!\"\u001b[39m\u001b(B\u001b[m)\r\u001b[2d"]
