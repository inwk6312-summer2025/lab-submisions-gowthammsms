[5867.365992, "o", "interfaces = yaml.load(open(\u001b(B\u001b[0;1m\u001b[32m'interfaces.yml'\u001b[39m\u001b(B\u001b[m), Loader=yaml.SafeLoader)\r\u001b[8d"]
