[1009.626769, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[3d"]
[1009.627209, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[4d"]
[1009.627616, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[5d"]
[1009.6281, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[7d"]
[1009.628493, "o", "logging.basicConfig(level=logging.INFO)\r\u001b[9d"]
[1009.62895, "o", "HOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[31m # Replace as needed\r\u001b[10d"]
[1009.629346, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[11d"]
[1009.629666, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[12d"]
[1009.629983, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = f\u001b(B\u001b[0;1m\u001b[32m'http://{HOST}/restconf/api/running/'\r\u001b[14d"]
[1009.630419, "o", "\u001b[36mdef\u001b[34m get_interfaces\u001b[39m\u001b(B\u001b[m(endpoint):\u001b[15;5H"]
[1009.630805, "o", "url = BASE_URL + endpoint\u001b[16;5H"]
[1009.631243, "o", "headers = {\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m}\u001b[17;5H"]
[1009.631647, "o", "response = requests.get(url, auth=HTTPBasicAuth(USER, PASS), headers=headers)\u001b[18;5H"]
[1009.632106, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 200:\u001b[19;9H"]
[1009.632544, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m json.dumps(response.json(), indent=4)\u001b[20;5H"]
[1009.632943, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[21d\b"]
[1009.63338, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m f\u001b(B\u001b[0;1m\u001b[32m\"Error: {response.status_code}\"\r\u001b[23d"]
[1009.633807, "o", "\u001b[39m\u001b(B\u001b[mprint(get_interfaces(\u001b(B\u001b[0;1m\u001b[32m'interfaces'\u001b[39m\u001b(B\u001b[m))\r\u001b[24d"]
[1009.634225, "o", "\u001b[?12l\u001b[?25h"]
[1055.245766, "o", "\u001b[?25l\u001b[49d\u001b(B\u001b[0;7mSave modified buffer?                                                                                 \u001b[50;1H Y\u001b(B\u001b[m Yes\u001b[K\r\u001b[51d\u001b(B\u001b[0;7m N\u001b(B\u001b[m No  \u001b[15G  \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cancel\u001b[K\u001b[49;23H\u001b[?12l\u001b[?25h"]
