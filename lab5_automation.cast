[1005.397848, "o", "\u001b[H"]
[1005.398376, "o", "\u001b(B\u001b[0;7m  GNU nano 4.8                               get_interface.py                                         \u001b[1;101H"]
[1005.398823, "o", "\u001b(B\u001b[m"]
[1005.399454, "o", "\r\u001b[50d"]
[1005.399831, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[51d"]
[1005.400225, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G"]
[1005.400566, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[49d"]
[1005.401022, "o", "\u001b[2d"]
[1005.401329, "o", "\u001b[39;49m\u001b(B\u001b[m"]
[1005.40163, "o", "\u001b[?12l\u001b[?25h"]
[1009.57337, "o", "\u001b[?25l"]
